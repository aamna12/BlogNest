<%- include('./partials/head') %>
<title>Add A New Blog</title>
<%- include('./partials/navbar') %>
<form class='m-3' action="/blog/addblog" method="post" enctype="multipart/form-data">
    <h3 class = "display-6 mb-3">Fill in the below details to create your new blog</h3>
    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input type="text" class="form-control" id="title" name="title">
    </div>
    <div class="mb-3">
      <label for="content" class="form-label">Content</label>
      <div class="form-floating">
        <textarea class="form-control" id="content" style="height: 100px" name="content"></textarea>
      </div>
    </div>
    <div class="mb-3">
        <label for="coverImage" class="form-label">Cover Image</label>
        <input type="file" class="form-control" id="coverImage" name="coverImage">
      </div>
    <button type="submit" class="btn btn-success btn-lg">Create Blog</button>
  </form>
<%- include('./partials/scripts') %> 
</body>
</html>