<%- include('./partials/head') %>
<title><%= blog.title %> | BlogNest</title>
<%- include('./partials/navbar') %>
<div class="container my-5">
    <div class="card shadow-lg border-0">
      <img src="<%= blog.coverImage %>" class="card-img-top" alt="<%= blog.title %>" style="height: 400px; object-fit: cover;">
      
      <div class="card-body px-5 py-4">
        <h1 class="card-title display-5 fw-bold text-primary"><%= blog.title %></h1>
        <p class="text-muted mb-2">
            <img src="<%= blog.author.profileImageURL %>" class="card-img-top rounded-circle" alt="<%= blog.title %>" 
            style="height: 30px; width:30px;"><strong><%= blog.author.fullName %>
            </strong> • <%= blog.createdAt.toDateString() %></p>
        <hr>
        <div class="card-text fs-5" style="white-space: pre-line;">
          <%= blog.content %>
        </div>
        <div class="mt-5">
          <a href="/" class="btn btn-outline-secondary">← Back to Blogs</a>
        </div>
      </div>
    </div>
  </div>
  <div class="container">
    <h4>Comments: <% if (locals.comments.length > 0) { %>
      (<%=  comments.length%>)
     <% }%> </h4> 
    <% if (locals.comments.length > 0) { %>
      <% comments.forEach(comment => { %>
        <div class="d-flex align-items-start mb-2 border rounded p-2 bg-light">
          <img src="<%= comment.author.profileImageURL %>" 
               alt="User Image" class="rounded-circle me-3" width="40" height="40" style="object-fit: cover;">
          <div>
            <div class="d-flex flex-column justify-content-between ">
              <small class=" fw-semibold text-dark fs-6"><%= comment.author.fullName %></small>
              <small class="text-muted small"> <%= comment.createdAt.toDateString() %></small>
            </div>
            <p class="mb-0 small text-primary"> <%= comment.content %></p>
          </div>
        </div>
      <% }) %>
    <% } %>
    <% if (locals.user) { %>
      <form class="mb-5" action="/blog/comment/<%= blog._id %>" method="post">
        <div class="mb-3">
          <label for="content" class="form-label"></label>
          <input type="text" class="form-control" id="content" aria-describedby="content" name='content' placeholder="Comment here">
        </div>
        <button type="submit" class="btn btn-warning btn-sm">Post Comment</button>
      </form>
    <% } %>
    
  </div>
  
<%- include('./partials/scripts') %> 
</body>
</html>