<%- include('./partials/head') %>
<title>Blogging with BlogNest</title>
<%- include('./partials/navbar') %>
<% if (blogs) { %>
    <h3 class="display-3 text-center text-info m-2 fw-semibold">BLOGS</h3>
    <div class="m-3 d-flex flex-wrap justify-content-center gap-5">
        <% blogs.forEach(blog => { %>
            <div class="card" style="width: 20rem;">
                <img src="<%= blog.coverImage %>" class="card-img-top" alt="<%= blog.title %>"
                style="width: 100%; height: 190px;">
                <div class="card-body">
                  <h5 class="card-title"><%= blog.title %></h5>
                  <h6 class="card-subtitle mb-2 text-body-secondary fw-light">-<%= blog.author.fullName %></h6>
                  <a href="/blog/<%=blog._id%>" class="btn btn-primary">Read More</a>
                </div>
              </div>
        <% }) %>
    </div>
<% } %>
<%- include('./partials/scripts') %> 
</body>
</html>